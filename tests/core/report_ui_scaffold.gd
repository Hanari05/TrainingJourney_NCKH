extends Node

var requests: Array = []
func _ready() -> void: call_deferred("_run")
func _settle() -> void: await get_tree().create_timer(0.15).timeout
func _capture(viewport: SubViewport, filename: String) -> void:
	if DisplayServer.get_name() == "headless": return
	await RenderingServer.frame_post_draw
	assert(viewport.get_texture().get_image().save_png("res://" + filename) == OK)

func _run() -> void:
	assert(not Global.persistence_enabled)
	Global.cloud_db_enabled = false
	var before_profiles := Global.patient_profiles.duplicate(true)
	var before_queue := Global.cloud_outbox.duplicate(true)
	var viewport := SubViewport.new()
	viewport.size = Vector2i(1152, 760)
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	add_child(viewport)
	var screen = load("res://ui/screens/history/history_screen.tscn").instantiate()
	viewport.add_child(screen)
	await _settle()
	assert(screen._csv_button.disabled)
	screen.csv_export_requested.connect(func(pid: String): requests.append(pid))
	screen._csv_button.pressed.emit()
	assert(requests.is_empty())
	screen.set_csv_export_available(true)
	screen._csv_button.pressed.emit()
	screen._csv_button.pressed.emit()
	assert(requests.size() == 1 and requests[0] == Global.current_patient_id)
	assert(screen._csv_button.disabled)
	screen.set_csv_export_result("WRONG_ID", true, "Wrong response")
	assert(screen._csv_button.disabled)
	screen.set_csv_export_result(Global.current_patient_id, false, "Không thể ghi file thử nghiệm")
	assert(not screen._csv_button.disabled and screen._csv_status.text == "Không thể ghi file thử nghiệm")
	screen._csv_button.pressed.emit()
	screen.set_csv_export_result(Global.current_patient_id, true, "Đã xuất báo cáo thử nghiệm")
	assert(requests.size() == 2 and not screen._csv_button.disabled)
	var payload := {"context_label": "Map 2 · Tay phải · Dữ liệu minh họa kiểm thử", "unit": "degrees", "baseline": 19.0, "target": 90.0, "sessions": [{"date": "2026-11-05", "value": 36.0}]}
	assert(not screen.set_rom_report_data("WRONG_ID", payload))
	assert(screen.set_rom_report_data(Global.current_patient_id, payload))
	assert(screen._rom_chart._baseline == 19.0 and screen._rom_chart._points.size() == 1)
	# Clear the current payload to return to the real legacy/empty presentation.
	screen.set_rom_report_data(Global.current_patient_id, {})
	screen.set_csv_export_available(false)
	screen._mode_toggle_btn.pressed.emit()
	for dimensions in [Vector2i(1152,760), Vector2i(800,600), Vector2i(1600,900)]:
		viewport.size = dimensions
		await _settle()
		var card: Control = screen.find_child("PatientToolbar",true,false)
		assert(card.get_global_rect().end.x <= dimensions.x)
		assert(screen.find_child("ReportExportCard",true,false) == null)
		assert(screen._csv_button.get_parent() == screen._mode_toggle_btn.get_parent())
		assert(screen._csv_button.get_global_rect().end.x <= card.get_global_rect().end.x)
		await _capture(viewport, "report-ui-screen-%d.png" % dimensions.x)
		screen._show_section("report")
		await _settle()
		assert(screen._rom_chart.size.x <= dimensions.x)
		await _capture(viewport, "report-ui-section-%d.png" % dimensions.x)
		screen._show_section("overview")
		await _settle()
	# Delayed chart/export responses for the previous profile must not replace current UI.
	var old_id: String = Global.current_patient_id
	screen.set_csv_export_available(true)
	screen._csv_button.pressed.emit()
	Global.current_patient_id = "UI_TEST_OTHER"
	screen._refresh_all()
	screen.set_csv_export_result(old_id, true, "OLD PROFILE FILE")
	assert(screen._csv_status.text != "OLD PROFILE FILE")
	assert(not screen.set_rom_report_data(old_id, payload))
	assert(screen._rom_report_payload.is_empty())
	Global.current_patient_id = old_id
	screen.queue_free()
	await get_tree().process_frame
	var chart = load("res://ui/screens/history/rom_line_chart.gd").new()
	viewport.add_child(chart)
	chart.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	viewport.size = Vector2i(1100,560)
	chart.set_rom_points([])
	await _settle()
	assert(chart._empty.visible and chart._values[0].text == "—")
	await _capture(viewport, "report-ui-chart-empty.png")
	chart.set_progress_data(payload)
	await _settle()
	assert(chart._points.size() == 1 and chart._values[1].text == "36.0°")
	assert(chart._plot.get_global_rect().end.y < viewport.size.y - 16)
	for key in chart._legend.get_children(): assert(key.size.y < 50)
	assert(chart._note.text.contains("Mới có 1 buổi"))
	await _capture(viewport, "report-ui-chart-one.png")
	payload.sessions.append({"date": "2026-11-05", "value": 49.0})
	chart.set_progress_data(payload)
	await _settle()
	assert(chart._points.size() == 2)
	await _capture(viewport, "report-ui-chart-two.png")
	for i in range(2,10): payload.sessions.append({"date": "2026-11-05", "value": 49.0+i*4})
	chart.set_progress_data(payload)
	await _settle()
	assert(chart._points.size() == 8 and chart._total == 10)
	await _capture(viewport, "report-ui-chart-many.png")
	viewport.size = Vector2i(720,560)
	await _settle()
	await _capture(viewport, "report-ui-chart-small.png")
	chart.set_progress_data({"baseline": -5, "target": "90", "sessions": [{"value": NAN},{"value": -1},{"value": 0}]})
	await _settle()
	assert(chart._baseline == null and chart._target == null)
	assert(chart._points.size() == 1 and chart._values[1].text == "0.0")
	chart.set_rom_points([{"date": "2026-10-01", "source": "calibration", "rom_angle": 21}, {"date": "2026-10-03", "source": "calibration", "rom_angle": 25}, {"date": "2026-10-04", "source": "session", "rom_angle": 99}])
	await _settle()
	assert(chart._legacy and chart._unit == "index" and chart._points.size() == 2)
	assert(chart._baseline == null and chart._target == null)
	await _capture(viewport, "report-ui-chart-legacy.png")
	assert(Global.patient_profiles == before_profiles and Global.cloud_outbox == before_queue)
	viewport.queue_free()
	await get_tree().process_frame
	print("REPORT_UI_SCAFFOLD_PASS: scoped hooks, CSV lifecycle, empty/one/two/many, invalid values, legacy indices, responsive widths, no persistence")
	get_tree().quit()
